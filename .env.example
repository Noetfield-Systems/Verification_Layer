# Never commit populated .env files or production database copies.
# Local dev only: DATABASE_URL="file:../db/dev.db"
# Railway: DATABASE_URL must be the Postgres connection URI.
DATABASE_URL="file:../db/dev.db"
NOETFIELD_RECEIPT_SECRET="replace-with-unique-random-32-plus-byte-secret"
NOETFIELD_VERIFIER_SECRET="replace-with-different-random-32-plus-byte-secret"
NOETFIELD_SINA_CONTROL_TOKEN="replace-with-a-separate-random-32-plus-byte-token"
NOETFIELD_DEMO_SEED_TOKEN=""
NOETFIELD_FREE_TIER_LIMIT="100"
NOETFIELD_FREE_TIER_WINDOW_DAYS="30"
NOETFIELD_COST_PER_VERIFY_USD="0.0008"
# Mandatory to accept signups; otherwise signup fails closed with 503.
RESEND_API_KEY=""
NOETFIELD_EMAIL_FROM="Noetfield <login@noetfield.com>"
NOETFIELD_PUBLIC_BASE_URL="https://verify.noetfield.com"
